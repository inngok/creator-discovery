YOUTUBE_API_KEY=your_youtube_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
REDIS_URL=redis://localhost:6379/0
JAVA_BACKEND_URL=http://localhost:8080/api/v1/creators/ingest
JAVA_BACKEND_SECRET=
# Reuse an existing operator TikTok session; never commit session/cookie files.
TIKTOK_USE_SAVED_SESSION=true
# Optional absolute Playwright state path; default: data/playwright_state.json
# TIKTOK_SESSION_PATH=/secure/path/tiktok-state.json
